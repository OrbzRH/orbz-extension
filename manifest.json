{
  "manifest_version": 3,
  "name": "Orbz",
  "version": "0.1.0",
  "description": "Ask Orbz Opus about any page, paid from your $ORBZ credit. Select text, right-click, ask.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "Orbz",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "contextMenus",
    "sidePanel",
    "activeTab",
    "scripting",
    "alarms"
  ],
  "host_permissions": [
    "https://api.orbz.app/*"
  ]
}
